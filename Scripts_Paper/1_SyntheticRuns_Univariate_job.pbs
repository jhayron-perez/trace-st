#!/bin/bash
#PBS -N trace_hp
#PBS -A UMCP0021
#PBS -q main
#PBS -j oe
#PBS -k eod
#PBS -m abe
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l job_priority=premium

set -euo pipefail

module load conda
conda activate castle

WORKDIR="/glade/u/home/jhayron/Causality_CaStLe/PaperCausalBTs/Scripts_Paper"
cd "$WORKDIR"

OUTDIR="/glade/derecho/scratch/jhayron/DataCaStLeBTs/ResultsSynthetic/univariate_v0"
SCRIPT="1_SyntheticRuns_Univariate.py"
LOGDIR="${OUTDIR}/logs"

mkdir -p "${OUTDIR}" "${LOGDIR}"
export TMPDIR="${SCRATCH}/tmp_${PBS_JOBID}"
mkdir -p "${TMPDIR}"

echo "========== JOB INFO =========="
echo "date: $(date)"
echo "jobid: ${PBS_JOBID}"
echo "host: $(hostname)"
echo "workdir: ${WORKDIR}"
echo "outdir: ${OUTDIR}"
echo "tmpdir: ${TMPDIR}"
echo "=============================="

python -u "${SCRIPT}" \
  --outdir "${OUTDIR}" \
  --trials-per-method 1000 \
  --n-workers 120 \
  --flush-every 25 | tee -a "${LOGDIR}/run_${PBS_JOBID}.log"

echo "Finished at: $(date)"
