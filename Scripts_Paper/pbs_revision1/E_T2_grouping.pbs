#!/bin/bash
#PBS -N tst_E_T2_grouping
#PBS -A UMCP0021
#PBS -q main
#PBS -j oe
#PBS -k eod
#PBS -M jhayron@uchicago.edu
#PBS -m abe
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l job_priority=premium
# Revision-1 E (R1 major 2): T2 (3_SyntheticRuns_Multivariate.py, Elastic-Net), first 50 configs of the
# paper draw (seed 11), M = 30, alpha_mix grid 0.2 0.6, with --grouping $GROUPING.
# qsub -v REPO=<checkout>,GROUPING=<dbscan|strongest|variable_sign|sectors8|kmeans>[,DRYRUN=1] E_T2_grouping.pbs
# DRYRUN=1: 1 config, M = 2 into revision1/dryrun/. EXTRA_ARGS adds opt-in flags.
set -uo pipefail
: "${REPO:?set REPO}"
: "${GROUPING:?set GROUPING}"
module load conda
conda activate castle

R1="/glade/derecho/scratch/jhayron/DataCaStLeBTs/revision1"
SCRIPT="3_SyntheticRuns_Multivariate.py"
if [[ "${DRYRUN:-0}" == "1" ]]; then
  OUTDIR="$R1/dryrun/${OUTNAME:-E_grouping/T2_${GROUPING}}"
  ARGS=(--n-trials 1 --ensemble-size 2 --alpha-grid 0.2 0.6 --grouping "${GROUPING}" --n-workers 1 --flush-every 1 --seed 11)
else
  OUTDIR="$R1/${OUTNAME:-E_grouping/T2_${GROUPING}}"
  ARGS=(--n-trials 50 --ensemble-size 30 --alpha-grid 0.2 0.6 --grouping "${GROUPING}" --n-workers 50 --flush-every 5 --seed 11)
fi
cd "$REPO/Scripts_Paper" || exit 2
LOGDIR="${OUTDIR}/logs"
mkdir -p "${OUTDIR}" "${LOGDIR}"
export TMPDIR="${SCRATCH}/tmp_${PBS_JOBID}"
mkdir -p "${TMPDIR}"

echo "========== JOB INFO =========="
echo "date: $(date)"; echo "jobid: ${PBS_JOBID}"; echo "host: $(hostname)"
echo "repo: ${REPO} @ $(git -C "$REPO" describe --tags --always) $(git -C "$REPO" rev-parse HEAD)"
echo "outdir: ${OUTDIR}"; echo "args: ${ARGS[*]} ${EXTRA_ARGS:-}"
echo "=============================="

python -u "${SCRIPT}" --outdir "${OUTDIR}" "${ARGS[@]}" ${EXTRA_ARGS:-} 2>&1 | tee -a "${LOGDIR}/run_${PBS_JOBID}.log"
echo "python exit: ${PIPESTATUS[0]}"
echo "Finished at: $(date)"
