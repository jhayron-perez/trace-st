#!/bin/bash
#PBS -N tst_A1_pnw_twin
#PBS -A UMCP0021
#PBS -q main
#PBS -j oe
#PBS -k eod
#PBS -M jhayron@uchicago.edu
#PBS -m abe
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l job_priority=premium
# Night-2 A1: PNW one-at-a-time placebo twin. Required -v: REPO, PVAR (var stem), PYEAR. Optional DRYRUN=1.
# Runs the 233 retained T6r configs (revision1/T6r_pnw/retained_run_ids.txt), M 30, paper flags otherwise.
set -uo pipefail
module load conda
conda activate castle
: "${REPO:?set REPO}"; : "${PVAR:?set PVAR}"; : "${PYEAR:?set PYEAR}"
R1="/glade/derecho/scratch/jhayron/DataCaStLeBTs/revision1"
SCRIPT="8_HW_PNW21_Runs_v2.py"
IDS=$(cat "$R1/T6r_pnw/retained_run_ids.txt")
if [[ "${DRYRUN:-0}" == "1" ]]; then
  OUTDIR="$R1/dryrun/A1_pnw_twin/${PVAR}_${PYEAR}"
  ARGS=(--n-trials 300 --n-members 2 --nproc 2 --start-method fork --continue-if-exists --placebo-vars "$PVAR" --placebo-year "$PYEAR" --run-ids 0)
else
  OUTDIR="$R1/A1_pnw_twin/${PVAR}_${PYEAR}"
  ARGS=(--n-trials 300 --n-members 30 --nproc 120 --start-method fork --continue-if-exists --placebo-vars "$PVAR" --placebo-year "$PYEAR" --run-ids $IDS)
fi
cd "$REPO/Scripts_Paper" || exit 2
LOGDIR="${OUTDIR}/logs"
mkdir -p "${OUTDIR}" "${LOGDIR}"
export TMPDIR="${SCRATCH}/tmp_${PBS_JOBID}"
mkdir -p "${TMPDIR}"
echo "========== JOB INFO =========="
echo "date: $(date)"; echo "jobid: ${PBS_JOBID}"; echo "host: $(hostname)"
echo "repo: ${REPO} @ $(git -C "$REPO" describe --tags --always) $(git -C "$REPO" rev-parse HEAD)"
echo "outdir: ${OUTDIR}"; echo "args: ${ARGS[*]:0:14} ... (${#ARGS[@]} args)"
echo "=============================="
python -u "${SCRIPT}" --outdir "${OUTDIR}" "${ARGS[@]}" 2>&1 | tee -a "${LOGDIR}/run_${PBS_JOBID}.log"
echo "python exit: ${PIPESTATUS[0]}"
echo "Finished at: $(date)"
