#!/bin/bash
#PBS -N tst_A3_pinatubo
#PBS -A UMCP0021
#PBS -q main
#PBS -j oe
#PBS -k eod
#PBS -M jhayron@uchicago.edu
#PBS -m abe
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l job_priority=premium
# Night-2 A3: Pinatubo with extra E3SM fields. Required -v: REPO, XVARS (space-separated), OUTNAME.
# Same 1000-config draw and flags as T5r (999 retained there).
set -uo pipefail
module load conda
conda activate castle
: "${REPO:?set REPO}"; : "${XVARS:?set XVARS}"; : "${OUTNAME:?set OUTNAME}"
R1="/glade/derecho/scratch/jhayron/DataCaStLeBTs/revision1"
OUTDIR="$R1/A3_pinatubo_twin/${OUTNAME}"
LOGDIR="${OUTDIR}/logs"; mkdir -p "${OUTDIR}" "${LOGDIR}"
export TMPDIR="${SCRATCH}/tmp_${PBS_JOBID}"; mkdir -p "${TMPDIR}"
cd "$REPO/Scripts_Paper" || exit 2
read -r -a XV <<< "${XVARS}"
ARGS=(--n-trials 1000 --n-workers 120 --ensemble-size 30 --flush-every 10 --extra-vars "${XV[@]}")
echo "date: $(date)  jobid: ${PBS_JOBID}  host: $(hostname)"
echo "repo: ${REPO} @ $(git -C "$REPO" describe --tags --always) $(git -C "$REPO" rev-parse HEAD)"
echo "outdir: ${OUTDIR}  args: ${ARGS[*]}"
python -u 6_PinatuboRuns.py --outdir "${OUTDIR}" "${ARGS[@]}" 2>&1 | tee -a "${LOGDIR}/run_${PBS_JOBID}.log"
echo "python exit: ${PIPESTATUS[0]}"
echo "Finished at: $(date)"
