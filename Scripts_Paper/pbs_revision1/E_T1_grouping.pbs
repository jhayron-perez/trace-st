#!/bin/bash
#PBS -N tst_E_T1_grouping
#PBS -A UMCP0021
#PBS -q main
#PBS -j oe
#PBS -k eod
#PBS -M jhayron@uchicago.edu
#PBS -m abe
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=128:mpiprocs=128:mem=235GB
#PBS -l job_priority=premium
# Revision-1 E (R1 major 2): T1 (1_SyntheticRuns_Univariate.py), Elastic-Net only, first 200 configs of
# the paper draw (seed 11, ids unchanged), deterministic as the paper T1, with --grouping $GROUPING.
# qsub -v REPO=<checkout>,GROUPING=<dbscan|strongest|variable_sign|sectors8|kmeans>[,DRYRUN=1] E_T1_grouping.pbs
# DRYRUN=1: 2 configs into revision1/dryrun/. EXTRA_ARGS adds opt-in flags.
set -uo pipefail
: "${REPO:?set REPO}"
: "${GROUPING:?set GROUPING}"
module load conda
conda activate castle

R1="/glade/derecho/scratch/jhayron/DataCaStLeBTs/revision1"
SCRIPT="1_SyntheticRuns_Univariate.py"
if [[ "${DRYRUN:-0}" == "1" ]]; then
  OUTDIR="$R1/dryrun/${OUTNAME:-E_grouping/T1_${GROUPING}}"
  ARGS=(--trials-per-method 1000 --methods granger --n-configs 2 --grouping "${GROUPING}" --n-workers 2 --flush-every 1)
else
  OUTDIR="$R1/${OUTNAME:-E_grouping/T1_${GROUPING}}"
  ARGS=(--trials-per-method 1000 --methods granger --n-configs 200 --grouping "${GROUPING}" --n-workers 120 --flush-every 25)
fi
cd "$REPO/Scripts_Paper" || exit 2
LOGDIR="${OUTDIR}/logs"
mkdir -p "${OUTDIR}" "${LOGDIR}"
export TMPDIR="${SCRATCH}/tmp_${PBS_JOBID}"
mkdir -p "${TMPDIR}"

echo "========== JOB INFO =========="
echo "date: $(date)"; echo "jobid: ${PBS_JOBID}"; echo "host: $(hostname)"
echo "repo: ${REPO} @ $(git -C "$REPO" describe --tags --always) $(git -C "$REPO" rev-parse HEAD)"
echo "outdir: ${OUTDIR}"; echo "args: ${ARGS[*]} ${EXTRA_ARGS:-}"
echo "=============================="

python -u "${SCRIPT}" --outdir "${OUTDIR}" "${ARGS[@]}" ${EXTRA_ARGS:-} 2>&1 | tee -a "${LOGDIR}/run_${PBS_JOBID}.log"
echo "python exit: ${PIPESTATUS[0]}"
echo "Finished at: $(date)"
